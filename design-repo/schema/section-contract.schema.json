{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Section contract",
  "description": "Closed shape of every sections/<id>.json. `source` = provenance (what the component is, traceable to a JSX line range in the clone; verify_all.py re-reads the range); `semantic` = the AI-facing taxonomy (id equals the contract id; source.id never does). retrievalEligible is pinned in code (PINNED_RETRIEVAL in schema/semantic_validate.py and extraction/verify_all.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "label",
    "tag",
    "purpose",
    "purposeIsInferred",
    "nameSource",
    "evidence",
    "content",
    "constraints",
    "motion",
    "responsive",
    "assetRoles",
    "implementedBy",
    "implementedByAll",
    "source",
    "semantic",
    "retrievalEligible",
    "generatedAssetRoles",
    "layout"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(shell|hero|content|proof|cta|features|support|showcase)\\.[a-z0-9-]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "SHELL",
        "HERO",
        "CONTENT",
        "PROOF",
        "CTA",
        "FEATURES",
        "SUPPORT",
        "SHOWCASE"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "purposeIsInferred": {
      "type": "boolean"
    },
    "nameSource": {
      "type": "string",
      "enum": [
        "class",
        "heading",
        "id",
        "tag",
        "decomposition",
        "clone-source"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "instances",
        "routes",
        "measuredFrom"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "measured",
            "inferred"
          ]
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "routes": {
          "type": "integer",
          "minimum": 1
        },
        "measuredFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^src/[^:]+\\.jsx:\\d+-\\d+$"
          }
        },
        "decomposedFrom": {
          "type": "string",
          "minLength": 1
        },
        "reconMeasuredFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalProperties",
        "fields"
      ],
      "properties": {
        "additionalProperties": {
          "const": false
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "subheading": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "ctas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 0
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "images": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "string[]",
                    "cta[]",
                    "item[]",
                    "image[]"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "maxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "titleMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "bodyMaxWords": {
                  "type": "integer",
                  "minimum": 1
                },
                "assetRoles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onePerPage"
      ],
      "properties": {
        "onePerPage": {
          "type": "boolean"
        },
        "maxPerPage": {
          "type": "integer",
          "minimum": 2
        },
        "mustBeFirst": {
          "const": true
        },
        "mustBeLast": {
          "const": true
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPatterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "allowedPatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reducedMotionFallback": {
          "type": "string",
          "enum": [
            "disable-animation",
            "instant-state"
          ]
        }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measuredAt",
        "breakpoints",
        "desktop",
        "changes"
      ],
      "properties": {
        "measuredAt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktop": {
              "const": "1440px"
            },
            "mobile": {
              "const": "390px"
            }
          }
        },
        "breakpoints": {
          "const": "tokens/00-foundation/breakpoint.json"
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heightPx": {
              "type": "number",
              "minimum": 0
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heightPx": {
              "type": "number",
              "minimum": 0
            },
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "hiddenShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mobileNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedAssetRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementedBy": {
      "type": "string",
      "pattern": "^src/sections/[A-Za-z0-9]+\\.jsx$"
    },
    "implementedByAll": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^src/sections/[A-Za-z0-9]+\\.jsx$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "file",
        "tag",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^jsx:"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^src/sections/[A-Za-z0-9]+\\.jsx$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "SHELL",
            "HERO",
            "CONTENT",
            "PROOF",
            "CTA",
            "FEATURES",
            "SUPPORT",
            "SHOWCASE"
          ]
        }
      }
    },
    "retrievalEligible": {
      "type": "boolean"
    },
    "retrievalIneligibleReason": {
      "type": "string",
      "minLength": 30
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inFlow"
      ],
      "properties": {
        "inFlow": {
          "type": "boolean"
        }
      }
    },
    "contentPolicy": {
      "type": "string",
      "minLength": 30
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retrievalEligible": {
            "const": false
          }
        },
        "required": [
          "retrievalEligible"
        ]
      },
      "then": {
        "required": [
          "retrievalIneligibleReason"
        ]
      }
    }
  ]
}
