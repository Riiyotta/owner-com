{
  "id": "light",
  "mode": "light",
  "$description": "The only theme measured (the page as served). Every semantic token resolves to a real foundation value.",
  "resolves": {
    "surface.default": "rgb(255,255,255)",
    "surface.alt": "rgb(44,44,44)",
    "surface.inverse": "rgb(44,44,44)",
    "surface.accent": "rgb(9,68,19)",
    "text.primary": "rgb(44,44,44)",
    "text.secondary": "rgb(102,102,102)",
    "text.inverse": "rgb(255,255,255)",
    "text.accent": "rgb(8,137,36)",
    "border.default": "rgb(221,221,221)",
    "accent.primary": "rgb(8,137,36)",
    "typography.display": {
      "fontFamily": "STKBureauSans",
      "fontSize": "48px",
      "fontWeight": "600",
      "lineHeight": "48px"
    },
    "typography.heading": {
      "fontFamily": "STKBureauSans",
      "fontSize": "22px",
      "fontWeight": "600",
      "lineHeight": "27.94px"
    },
    "typography.body": {
      "fontFamily": "STKBureauSans",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "28.44px"
    },
    "typography.label": {
      "fontFamily": "STKBureauSans",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": "20.8px"
    },
    "radius.control": "16px",
    "radius.surface": "3.5px",
    "elevation.default": "rgba(44, 44, 44, 0.2) 0px 70px 76px 0px",
    "motion.duration.default": "0.45s",
    "motion.easing.default": "cubic-bezier(0.215, 0.61, 0.355, 1)"
  }
}
